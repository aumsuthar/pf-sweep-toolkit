# Copy to .env and adjust. Nothing here is secret — .env is gitignored anyway
# so local paths stay out of the repo.
#
#   set -a; source .env; set +a
#
# then run the analysis scripts normally.

# --- analysis scripts -------------------------------------------------------
# Directory holding set1_results.csv and set1_summary.csv, relative to the
# project root.
SIM_DIR=set1_simulation_results

# Workbook filename written by make_cm_excel.py.
OUT_NAME=CM_sweep.xlsx

# Suffix on generated figure filenames, so several sweeps can coexist
# (e.g. "_x3" -> set1_hysteresis_loops_x3.png).
FIG_SUFFIX=

# --- sweep driver (usually passed inline per run, not set here) -------------
# SWEEP_TAG=run01
# CYCLE_LOAD_LEVELS=0 5 10 15 17 19 20 22
# CYCLE_UNLOAD_LEVELS=21 18 16 14 12 11 9 6 3 0
# CYCLE_TOP_STRESS=22
